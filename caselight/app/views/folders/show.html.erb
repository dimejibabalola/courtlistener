<% content_for :title, "#{@folder.name} — Folders" %>
<div class="mx-auto max-w-4xl px-6 py-8">
  <%= link_to folders_path, class: "flex items-center gap-1.5 text-sm font-medium text-brand-700 hover:underline" do %>
    <%= icon :arrow_left, class: "h-4 w-4" %> All folders
  <% end %>

  <header class="mt-3 flex items-center justify-between">
    <div>
      <h1 class="flex items-center gap-2 text-xl font-bold text-gray-900">
        <%= icon :folder, class: "h-5 w-5 text-brand-600" %> <%= @folder.name %>
        <% if @folder.shared? %><span class="badge-gray">shared</span><% end %>
      </h1>
      <p class="mt-0.5 text-sm text-gray-500">
        <%= @items.size %> items
        <% if @folder.matter %> · matter: <%= link_to @folder.matter.name, matter_path(@folder.matter), class: "hover:text-brand-700" %><% end %>
      </p>
    </div>
  </header>

  <ul class="card mt-5 divide-y divide-gray-100">
    <% @items.each do |folder_item| %>
      <li class="flex items-center gap-3 p-3.5">
        <% case folder_item.item %>
        <% when Document %>
          <% doc = folder_item.item %>
          <%= classification_dot(doc.treatment_status == "untreated" ? :none : { "positive" => :positive, "cautionary" => :cautionary, "negative" => :negative }[doc.treatment_status]) %>
          <div class="min-w-0 flex-1">
            <%= link_to doc.title, document_path(doc), class: "font-serif text-sm font-semibold text-gray-900 hover:text-brand-700" %>
            <p class="text-xs text-gray-500"><%= doc.display_citation %> · <%= doc.court_line %></p>
          </div>
          <%= treatment_badge(doc) %>
        <% when UploadedDocument %>
          <%= icon :upload, class: "h-4 w-4 shrink-0 text-gray-400" %>
          <div class="min-w-0 flex-1">
            <%= link_to folder_item.item.title, upload_path(folder_item.item), class: "text-sm font-semibold text-gray-900 hover:text-brand-700" %>
            <p class="text-xs text-gray-500">Uploaded document · <%= folder_item.item.kind %></p>
          </div>
        <% when Draft %>
          <%= icon :pencil, class: "h-4 w-4 shrink-0 text-gray-400" %>
          <div class="min-w-0 flex-1">
            <%= link_to folder_item.item.title, edit_draft_path(folder_item.item), class: "text-sm font-semibold text-gray-900 hover:text-brand-700" %>
            <p class="text-xs text-gray-500">Draft</p>
          </div>
        <% end %>
        <span class="shrink-0 text-[11px] text-gray-400">added <%= time_ago_in_words(folder_item.created_at) %> ago<%= " by #{folder_item.added_by.first_name}" if folder_item.added_by && folder_item.added_by != current_user %></span>
        <%= button_to folder_item_path(folder_item), method: :delete, class: "shrink-0 p-1 text-gray-300 hover:text-red-600", aria: { label: "Remove from folder" } do %>
          <%= icon :x, class: "h-4 w-4" %>
        <% end %>
      </li>
    <% end %>
    <% if @items.empty? %>
      <li class="p-8 text-center text-sm text-gray-500">
        Empty folder — use <span class="font-medium">Save</span> on any search result or
        <span class="font-medium">Save to Matter</span> in the reader.
      </li>
    <% end %>
  </ul>
</div>
