<% content_for :title, "New Folder — Caselight" %>
<div class="mx-auto max-w-xl px-6 py-10">
  <h1 class="text-xl font-bold text-gray-900">New Folder</h1>
  <div class="card mt-5 p-5">
    <%= form_with model: @folder, class: "space-y-4" do |f| %>
      <div>
        <%= f.label :name, class: "field-label" %>
        <%= f.text_field :name, class: "field-input", required: true, placeholder: "e.g. Piercing the Corporate Veil" %>
      </div>
      <div>
        <%= f.label :matter_id, "Matter (optional)", class: "field-label" %>
        <%= f.collection_select :matter_id, current_user.visible_matters.kept.order(:name), :id, :name, { include_blank: "— none —" }, class: "field-input" %>
      </div>
      <% if current_user.organization %>
        <label class="flex items-center gap-2 text-sm text-gray-700">
          <%= f.check_box :shared, class: "rounded border-gray-300 text-brand-600 focus:ring-brand-500" %>
          Share with <%= current_user.organization.name %>
        </label>
      <% end %>
      <div class="flex gap-2">
        <%= f.submit "Create folder", class: "btn-primary" %>
        <%= link_to "Cancel", folders_path, class: "btn-ghost" %>
      </div>
    <% end %>
  </div>
</div>
