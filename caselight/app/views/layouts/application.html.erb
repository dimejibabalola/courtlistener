<!DOCTYPE html>
<html lang="en" class="h-full">
  <head>
    <title><%= content_for(:title) || "Caselight Research" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="application-name" content="Caselight">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= turbo_refreshes_with method: :morph, scroll: :preserve %>
    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="h-full overflow-hidden bg-gray-100 font-sans text-gray-900">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:bg-white focus:px-3 focus:py-2 focus:text-sm">Skip to main content</a>

    <% if user_signed_in? %>
      <div class="flex h-full flex-col" data-controller="sidebar">
        <%= render "shared/topbar" %>
        <div class="flex min-h-0 flex-1">
          <%= render "shared/sidebar" %>
          <main id="main" class="min-w-0 flex-1 overflow-y-auto" tabindex="-1">
            <%= yield %>
          </main>
        </div>
      </div>
    <% else %>
      <main id="main" class="flex h-full items-center justify-center bg-ink-900 p-6">
        <%= yield %>
      </main>
    <% end %>

    <%= render "shared/flash" %>
  </body>
</html>
