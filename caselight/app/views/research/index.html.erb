<% content_for :title, @query.present? ? "#{@query} — Caselight Research" : "Research — Caselight" %>

<div class="flex h-full min-h-0 bg-gray-100">
  <%# Results column %>
  <section class="flex w-[22rem] shrink-0 flex-col border-r border-gray-200 bg-white" aria-label="Search results">
    <% if @results %>
      <%= render "research/results_column" %>
    <% else %>
      <%= render "research/empty_state" %>
    <% end %>
  </section>

  <%# Document pane %>
  <section class="min-w-0 flex-1 overflow-y-auto bg-white" aria-label="Document">
    <%= turbo_frame_tag "document_pane", target: "_top" do %>
      <% if @selected_document %>
        <%= render "research/document_pane" %>
      <% else %>
        <div class="flex h-full items-center justify-center p-12 text-center text-sm text-gray-500">
          <div>
            <%= icon :research, class: "mx-auto mb-3 h-10 w-10 text-gray-300" %>
            Run a search, then select a result to read it here.
          </div>
        </div>
      <% end %>
    <% end %>
  </section>

  <%# Refine rail %>
  <aside class="hidden w-72 shrink-0 overflow-y-auto border-l border-gray-200 bg-gray-50 xl:block" aria-label="Refine and tools">
    <%= render "research/refine_rail" %>
  </aside>
</div>
