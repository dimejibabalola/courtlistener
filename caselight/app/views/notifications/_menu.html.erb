<div class="flex items-center justify-between border-b border-gray-100 px-4 py-2.5">
  <span class="text-sm font-semibold">Alerts</span>
  <%= button_to "Mark all read", mark_all_read_notifications_path, class: "text-xs font-medium text-brand-700 hover:underline" %>
</div>
<ul class="max-h-80 divide-y divide-gray-50 overflow-y-auto">
  <% if notifications.blank? %>
    <li class="px-4 py-6 text-center text-sm text-gray-500">No alerts yet. Enable alerts on a saved search.</li>
  <% end %>
  <% notifications.each do |n| %>
    <li class="px-4 py-2.5 <%= "bg-brand-50/60" unless n.read? %>">
      <%= link_to (n.url.presence || notifications_path), class: "block" do %>
        <p class="text-[13px] font-semibold text-gray-900"><%= n.title %></p>
        <% if n.body.present? %><p class="mt-0.5 line-clamp-2 text-xs text-gray-500"><%= n.body %></p><% end %>
        <p class="mt-1 text-[11px] text-gray-400"><%= time_ago_in_words(n.created_at) %> ago</p>
      <% end %>
    </li>
  <% end %>
</ul>
<div class="border-t border-gray-100 px-4 py-2 text-center">
  <%= link_to "View all alerts", notifications_path, class: "text-xs font-semibold text-brand-700 hover:underline" %>
</div>
