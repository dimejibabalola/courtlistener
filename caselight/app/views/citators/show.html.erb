<% content_for :title, "Citing references — #{@document.title}" %>
<div class="mx-auto max-w-6xl px-6 py-6">
  <%= link_to document_path(@document), class: "flex items-center gap-1.5 text-sm font-medium text-brand-700 hover:underline" do %>
    <%= icon :arrow_left, class: "h-4 w-4" %> Back to document
  <% end %>

  <header class="mt-3 flex flex-wrap items-end justify-between gap-3">
    <div>
      <h1 class="font-serif text-2xl font-bold text-gray-900"><%= @document.title %></h1>
      <p class="mt-0.5 text-sm text-gray-600"><%= @document.display_citation %> · <%= @document.court_line %></p>
    </div>
    <%= treatment_badge(@document, size: :md) %>
  </header>

  <div class="mt-4 grid gap-3 sm:grid-cols-5">
    <% {
      "Cited By" => [@counts[:cited_by], "text-gray-900"],
      "Positive" => [@counts[:positive], "text-green-700"],
      "Cautionary" => [@counts[:cautionary], "text-amber-600"],
      "Negative" => [@counts[:negative], "text-red-700"],
      "Cites" => [@document.cites_count, "text-gray-900"]
    }.each do |label, (value, color)| %>
      <div class="card p-3 text-center">
        <p class="text-2xl font-bold tabular-nums <%= color %>"><%= number_compact(value) %></p>
        <p class="text-xs font-medium uppercase tracking-wide text-gray-500"><%= label %></p>
      </div>
    <% end %>
  </div>

  <section class="card mt-5 p-4" aria-label="Citation graph">
    <h2 class="text-sm font-bold text-gray-900">Citing-References Graph</h2>
    <p class="text-xs text-gray-500">Edges colored by treatment (green positive · amber cautionary · red negative); node size shows depth of treatment; distance from center reflects recency.</p>
    <div class="relative mt-2" data-controller="graph" data-graph-url-value="<%= graph_document_citator_path(@document) %>">
      <div data-graph-target="canvas" class="min-h-[480px]"></div>
      <div data-graph-target="tooltip" class="pointer-events-none absolute z-10 hidden w-52 rounded border border-gray-200 bg-white p-2 text-xs shadow-lg"></div>
    </div>
  </section>

  <section class="mt-6" aria-label="Citing references list">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <h2 class="text-sm font-bold text-gray-900">Citing References (<%= number_compact(@counts[:cited_by]) %>)</h2>
      <%= form_with url: document_citator_path(@document), method: :get, class: "flex flex-wrap items-center gap-2 text-xs", data: { controller: "autosubmit" } do %>
        <%= select_tag :classification, options_for_select([["All treatment", ""], ["Positive", "positive"], ["Cautionary", "cautionary"], ["Negative", "negative"]], @classification),
              class: "field-input !w-auto !py-1 text-xs", data: { action: "change->autosubmit#submit" }, aria: { label: "Filter by treatment" } %>
        <%= select_tag :depth, options_for_select([["Any depth", ""]] + CitingReference.depths.keys.map { |d| [d.humanize, d] }, @depth),
              class: "field-input !w-auto !py-1 text-xs", data: { action: "change->autosubmit#submit" }, aria: { label: "Filter by depth of treatment" } %>
        <%= select_tag :jurisdiction_id, options_for_select([["All jurisdictions", ""]] + @jurisdictions.map { |j| [j.name, j.id] }, params[:jurisdiction_id]),
              class: "field-input !w-auto !py-1 text-xs", data: { action: "change->autosubmit#submit" }, aria: { label: "Filter by jurisdiction" } %>
      <% end %>
    </div>

    <ul class="mt-3 divide-y divide-gray-100">
      <% @citing_references.each do |ref| %>
        <li class="flex items-start gap-3 py-3">
          <%= classification_dot(ref.classification) %>
          <div class="min-w-0 flex-1">
            <%= link_to ref.citing_document.title, document_path(ref.citing_document), class: "font-serif text-sm font-semibold text-gray-900 hover:text-brand-700" %>
            <p class="text-xs text-gray-500">
              <%= ref.citing_document.display_citation %> · <%= ref.citing_document.court_line %>
              <% if ref.pin_cite.present? %> · pin cite <%= ref.pin_cite %><% end %>
            </p>
            <% if ref.passage.present? %><p class="mt-1 line-clamp-2 text-[13px] text-gray-600">“<%= ref.passage %>”</p><% end %>
          </div>
          <div class="flex shrink-0 flex-col items-end gap-1">
            <span class="<%= { positive: "badge-green", cautionary: "badge-yellow", negative: "badge-red" }[ref.classification] %>"><%= ref.treatment_label %></span>
            <span class="text-[11px] text-gray-400"><%= ref.depth.humanize %></span>
          </div>
        </li>
      <% end %>
      <% if @citing_references.empty? %>
        <li class="py-6 text-center text-sm text-gray-500">No citing references match these filters.</li>
      <% end %>
    </ul>
  </section>

  <% if @cited.any? %>
    <section class="mt-8" aria-label="Authorities cited">
      <h2 class="text-sm font-bold text-gray-900">Authorities This Document Cites (<%= number_compact(@document.cites_count) %>)</h2>
      <ul class="mt-3 divide-y divide-gray-100">
        <% @cited.each do |ref| %>
          <li class="flex items-center justify-between gap-3 py-2.5">
            <div class="min-w-0">
              <%= link_to ref.cited_document.title, document_path(ref.cited_document), class: "text-sm font-medium text-gray-800 hover:text-brand-700" %>
              <span class="ml-2 text-xs text-gray-500"><%= ref.cited_document.display_citation %></span>
            </div>
            <%= treatment_badge(ref.cited_document) %>
          </li>
        <% end %>
      </ul>
    </section>
  <% end %>
</div>
