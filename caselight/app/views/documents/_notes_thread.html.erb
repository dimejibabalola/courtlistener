<section class="card p-4" aria-label="Notes" id="notes-thread">
  <h2 class="flex items-center gap-2 text-sm font-bold text-gray-900">
    Notes
    <span class="rounded-full bg-gray-100 px-1.5 text-xs font-semibold text-gray-600"><%= notes.size %></span>
  </h2>

  <%= form_with url: document_annotations_path(document), method: :post, class: "mt-3" do |f| %>
    <%= hidden_field_tag "annotation[kind]", "note" %>
    <%= text_field_tag "annotation[body]", nil, placeholder: "Add a note…", required: true,
          class: "field-input", aria: { label: "Add a note" } %>
  <% end %>

  <ul class="mt-3 space-y-3" id="notes-list">
    <% shown = compact ? notes.first(2) : notes %>
    <% shown.each do |note| %>
      <li id="<%= dom_id(note) %>" class="flex gap-2.5">
        <span class="mt-0.5 flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-ink-800 text-[10px] font-bold text-white"><%= note.user.initials %></span>
        <div class="min-w-0 flex-1">
          <p class="text-xs text-gray-500">
            <span class="font-semibold text-gray-800"><%= note.user == current_user ? "You" : note.user.full_name %></span>
            · <%= note.created_at.strftime("%b %-d") %>
            <% if note.highlight? %><span class="badge-yellow ml-1">highlight</span><% end %>
          </p>
          <% if note.quote.present? %>
            <blockquote class="mt-1 border-l-2 border-amber-300 pl-2 text-xs italic text-gray-600"><%= note.quote.truncate(180) %></blockquote>
          <% end %>
          <% if note.body.present? %><p class="mt-0.5 text-[13px] text-gray-800"><%= note.body %></p><% end %>
        </div>
        <% if note.user == current_user %>
          <%= button_to annotation_path(note), method: :delete, class: "self-start p-1 text-gray-300 hover:text-red-600", form: { data: { turbo_confirm: "Delete this note?" } }, aria: { label: "Delete note" } do %>
            <%= icon :trash, class: "h-3.5 w-3.5" %>
          <% end %>
        <% end %>
      </li>
    <% end %>
  </ul>
  <% if compact && notes.size > 2 %>
    <p class="mt-2 text-xs"><%= link_to "View all #{notes.size} notes", "#notes-thread", class: "font-medium text-brand-700 hover:underline" %></p>
  <% end %>
</section>
