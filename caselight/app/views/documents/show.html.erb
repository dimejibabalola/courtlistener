<% content_for :title, "#{@document.title} — Caselight" %>
<div class="mx-auto max-w-6xl bg-white">
  <%= render "documents/pane",
        document: @document,
        tab: @tab,
        notes: @notes,
        treatment_counts: @treatment_counts,
        pinned: @pinned,
        back_url: research_path,
        tab_url: ->(t) { document_path(@document, tab: t) },
        show_back: true %>
</div>
