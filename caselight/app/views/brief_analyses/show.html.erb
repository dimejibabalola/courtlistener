<% content_for :title, "Table of Authorities — #{@upload.title}" %>
<div class="mx-auto max-w-6xl px-6 py-8">
  <%= link_to upload_path(@upload), class: "flex items-center gap-1.5 text-sm font-medium text-brand-700 hover:underline" do %>
    <%= icon :arrow_left, class: "h-4 w-4" %> Back to document
  <% end %>

  <header class="mt-3 flex flex-wrap items-end justify-between gap-3">
    <div>
      <h1 class="text-xl font-bold text-gray-900">Table of Authorities</h1>
      <p class="mt-0.5 text-sm text-gray-500"><%= @upload.title %> · analyzed <%= @analysis.completed_at ? time_ago_in_words(@analysis.completed_at) + " ago" : "—" %></p>
    </div>
    <div class="flex items-center gap-1.5">
      <%= link_to "Export CSV", export_upload_brief_analysis_path(@upload, @analysis, format: :csv), class: "btn-outline !py-1.5", data: { turbo: false } %>
      <%= link_to "Export DOCX", export_upload_brief_analysis_path(@upload, @analysis, format: :docx), class: "btn-outline !py-1.5", data: { turbo: false } %>
      <%= button_to "Re-run", upload_brief_analyses_path(@upload), class: "btn-ghost" %>
    </div>
  </header>

  <% if @analysis.complete? %>
    <div class="mt-4 flex flex-wrap items-center gap-2" role="group" aria-label="Filter authorities by status">
      <% { nil => "All (#{@analysis.authorities_count})",
           "clean" => "Clean (#{@analysis.clean_count})",
           "cautionary" => "Cautionary (#{@analysis.cautionary_count})",
           "negative" => "Negative (#{@analysis.negative_count})",
           "unmatched" => "Unmatched (#{@analysis.unmatched_count})" }.each do |key, label| %>
        <%= link_to label, upload_brief_analysis_path(@upload, @analysis, status: key),
              class: class_names("rounded-full border px-3 py-1 text-xs font-semibold",
                                 key == @status_filter ? "border-brand-600 bg-brand-600 text-white" : "border-gray-300 bg-white text-gray-700 hover:border-brand-400") %>
      <% end %>
    </div>

    <% if @analysis.negative_count.positive? %>
      <div class="card mt-4 flex items-center gap-2 border-red-200 bg-red-50 p-3 text-sm text-red-900">
        <%= icon :x, class: "h-4 w-4 shrink-0" %>
        This brief relies on <%= pluralize(@analysis.negative_count, "authority") %> with negative treatment — review before filing.
      </div>
    <% end %>

    <div class="card mt-4 overflow-x-auto">
      <table class="w-full text-left text-sm">
        <thead class="border-b border-gray-200 bg-gray-50 text-xs uppercase tracking-wide text-gray-500">
          <tr>
            <th scope="col" class="px-4 py-2.5">Authority</th>
            <th scope="col" class="px-4 py-2.5">As cited in brief</th>
            <th scope="col" class="px-4 py-2.5">Pin</th>
            <th scope="col" class="px-4 py-2.5">Type</th>
            <th scope="col" class="px-4 py-2.5">Status</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          <% @citations.each do |bc| %>
            <tr class="<%= "bg-red-50/50" if bc.authority_status == "negative" %>">
              <td class="max-w-xs px-4 py-3">
                <% if bc.document %>
                  <%= link_to bc.document.title, document_path(bc.document), class: "font-serif font-semibold text-gray-900 hover:text-brand-700" %>
                  <p class="text-xs text-gray-500"><%= bc.document.display_citation %> · <%= bc.document.court_line %></p>
                <% else %>
                  <span class="font-medium text-gray-700"><%= bc.raw_cite %></span>
                  <p class="text-xs text-amber-700">Not matched to the corpus — verify manually.</p>
                <% end %>
                <% if bc.context.present? %>
                  <details class="mt-1">
                    <summary class="cursor-pointer text-[11px] font-medium text-gray-400 hover:text-gray-600">context from brief</summary>
                    <p class="mt-1 text-xs italic text-gray-600">“…<%= bc.context %>…”</p>
                  </details>
                <% end %>
              </td>
              <td class="px-4 py-3 font-mono text-xs text-gray-700"><%= bc.raw_cite %>
                <% if bc.resolved_from %><p class="mt-0.5 text-[11px] text-gray-400">↳ resolves to <%= bc.resolved_from.raw_cite %></p><% end %>
              </td>
              <td class="px-4 py-3 text-xs tabular-nums text-gray-600"><%= bc.pin_cite || "—" %></td>
              <td class="px-4 py-3 text-xs text-gray-600"><%= bc.kind.humanize %></td>
              <td class="px-4 py-3">
                <% case bc.authority_status %>
                <% when "negative" %><span class="badge-red">Negative</span>
                <% when "cautionary" %><span class="badge-yellow">Cautionary</span>
                <% when "clean" %><span class="badge-green">Clean</span>
                <% else %><span class="badge-gray"><%= bc.needs_review? ? "Needs review" : "Unmatched" %></span>
                <% end %>
              </td>
            </tr>
          <% end %>
          <% if @citations.empty? %>
            <tr><td colspan="5" class="px-4 py-8 text-center text-sm text-gray-500">No citations in this filter.</td></tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% elsif @analysis.failed? %>
    <div class="card mt-6 border-red-200 bg-red-50 p-4 text-sm text-red-900">Analysis failed: <%= @analysis.error_message %></div>
  <% else %>
    <div class="card mt-6 p-8 text-center text-sm text-gray-500">
      <p class="font-medium text-gray-700">Analyzing authorities…</p>
      <p class="mt-1">Citations are being extracted and checked against the citator. Refresh in a moment.</p>
    </div>
  <% end %>
</div>
