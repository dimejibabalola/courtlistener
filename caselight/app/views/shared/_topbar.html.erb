<header class="flex h-14 shrink-0 items-center gap-3 bg-ink-950 px-3 text-white">
  <button type="button" class="rounded p-2 hover:bg-ink-700 focus-visible:outline-2 focus-visible:outline-brand-500"
          data-action="sidebar#toggle" aria-label="Toggle navigation">
    <%= icon :menu, class: "h-5 w-5" %>
  </button>

  <%= link_to research_path, class: "flex items-center gap-2 pr-2", aria: { label: "Caselight Research home" } do %>
    <span class="flex h-8 w-8 items-center justify-center rounded bg-brand-600"><%= icon :scale, class: "h-5 w-5 text-white" %></span>
    <span class="text-lg font-semibold tracking-tight">Research</span>
  <% end %>

  <%= form_with url: research_path, method: :get, class: "flex min-w-0 max-w-3xl flex-1 items-stretch" do |f| %>
    <div class="relative flex min-w-0 flex-1 items-center rounded-l bg-white">
      <span class="pointer-events-none absolute left-3 text-gray-400"><%= icon :search, class: "h-4 w-4" %></span>
      <%= f.search_field :q, value: params[:q],
            placeholder: "When can a court disregard corporate entity to impose personal liability on shareholders?",
            class: "w-full rounded-l border-0 bg-transparent py-2 pl-9 pr-2 text-sm text-gray-900 placeholder-gray-500 focus:ring-0",
            aria: { label: "Search query: natural language, terms and connectors, or a citation" } %>
    </div>
    <div class="flex items-center border-l border-gray-200 bg-white px-1">
      <%= f.select :scope,
            options_for_select([["All State & Federal", "all"], ["Federal", "federal"], ["State", "state"]], params[:scope].presence || "all"),
            {}, class: "border-0 bg-transparent py-2 pr-7 text-sm text-gray-700 focus:ring-0", aria: { label: "Jurisdiction scope" } %>
    </div>
    <button type="submit" class="rounded-r bg-brand-600 px-5 text-sm font-semibold hover:bg-brand-700 focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-brand-400">Search</button>
    <%= link_to "Advanced", research_path, class: "ml-3 self-center text-sm font-medium text-gray-200 underline-offset-2 hover:underline" %>
  <% end %>

  <div class="ml-auto flex items-center gap-1">
    <%= link_to history_path, class: "flex items-center gap-1.5 rounded px-2.5 py-2 text-sm text-gray-200 hover:bg-ink-700", aria: { label: "History" } do %>
      <%= icon :history, class: "h-5 w-5" %><span class="hidden lg:inline">History</span>
    <% end %>

    <div class="relative" data-controller="dropdown">
      <button type="button" data-action="dropdown#toggle" data-dropdown-target="button" aria-expanded="false"
              class="relative flex items-center gap-1.5 rounded px-2.5 py-2 text-sm text-gray-200 hover:bg-ink-700" aria-label="Alerts">
        <%= icon :bell, class: "h-5 w-5" %><span class="hidden lg:inline">Alerts</span>
        <% if unread_alerts_count.positive? %>
          <span class="absolute -top-0.5 right-0 flex h-4 min-w-4 items-center justify-center rounded-full bg-red-600 px-1 text-[10px] font-bold lg:right-7"><%= unread_alerts_count %></span>
        <% end %>
      </button>
      <div data-dropdown-target="panel" data-action="click->dropdown#stop"
           class="absolute right-0 z-40 mt-1 hidden w-80 rounded-lg border border-gray-200 bg-white text-gray-900 shadow-xl">
        <%= render "notifications/menu", notifications: current_user.notifications.recent_first.limit(8) %>
      </div>
    </div>

    <div class="relative" data-controller="dropdown">
      <button type="button" data-action="dropdown#toggle" data-dropdown-target="button" aria-expanded="false"
              class="ml-1 flex items-center gap-1 rounded-full p-1 hover:bg-ink-700" aria-label="Account menu">
        <span class="flex h-8 w-8 items-center justify-center rounded-full bg-brand-200 text-xs font-bold text-brand-900"><%= current_user.initials %></span>
        <%= icon :chevron_down, class: "h-3.5 w-3.5 text-gray-300" %>
      </button>
      <div data-dropdown-target="panel" data-action="click->dropdown#stop"
           class="absolute right-0 z-40 mt-1 hidden w-56 rounded-lg border border-gray-200 bg-white py-1 text-gray-900 shadow-xl">
        <div class="border-b border-gray-100 px-4 py-2">
          <p class="truncate text-sm font-semibold"><%= current_user.full_name %></p>
          <p class="truncate text-xs text-gray-500"><%= current_user.email %></p>
        </div>
        <%= link_to "Settings", settings_path, class: "block px-4 py-2 text-sm hover:bg-gray-50" %>
        <%= link_to "Archive", archive_path, class: "block px-4 py-2 text-sm hover:bg-gray-50" %>
        <%= link_to "Trash", trash_path, class: "block px-4 py-2 text-sm hover:bg-gray-50" %>
        <%= button_to "Sign out", destroy_user_session_path, method: :delete,
              class: "block w-full px-4 py-2 text-left text-sm text-red-700 hover:bg-red-50" %>
      </div>
    </div>
  </div>
</header>
