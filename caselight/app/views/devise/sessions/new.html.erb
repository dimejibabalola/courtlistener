<div class="w-full max-w-sm">
  <div class="mb-6 flex items-center justify-center gap-2 text-white">
    <span class="flex h-10 w-10 items-center justify-center rounded bg-brand-600"><%= icon :scale, class: "h-6 w-6" %></span>
    <span class="text-2xl font-semibold tracking-tight">Research</span>
  </div>

  <div class="card p-6 shadow-2xl">
    <h1 class="text-lg font-bold text-gray-900">Sign in</h1>
    <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "mt-4 space-y-4" }) do |f| %>
      <div>
        <%= f.label :email, class: "field-label" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "field-input" %>
      </div>
      <div>
        <%= f.label :password, class: "field-label" %>
        <%= f.password_field :password, autocomplete: "current-password", class: "field-input" %>
      </div>
      <% if devise_mapping.rememberable? %>
        <label class="flex items-center gap-2 text-sm text-gray-600">
          <%= f.check_box :remember_me, class: "rounded border-gray-300 text-brand-600 focus:ring-brand-500" %> Remember me
        </label>
      <% end %>
      <%= f.submit "Sign in", class: "btn-primary w-full" %>
    <% end %>
    <div class="mt-4 flex justify-between text-xs">
      <%= link_to "Create an account", new_registration_path(resource_name), class: "font-medium text-brand-700 hover:underline" %>
      <%= link_to "Forgot password?", new_password_path(resource_name), class: "text-gray-500 hover:underline" %>
    </div>
  </div>
  <p class="mt-4 text-center text-xs text-ink-300">Demo login: <span class="font-mono">alex@example.com / password123</span></p>
</div>
