<div class="w-full max-w-sm">
  <div class="card p-6 shadow-2xl">
    <h1 class="text-lg font-bold text-gray-900">Reset password</h1>
    <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post, class: "mt-4 space-y-4" }) do |f| %>
      <div>
        <%= f.label :email, class: "field-label" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "field-input" %>
      </div>
      <%= f.submit "Send reset instructions", class: "btn-primary w-full" %>
    <% end %>
    <p class="mt-4 text-center text-xs">
      <%= link_to "Back to sign in", new_session_path(resource_name), class: "font-medium text-brand-700 hover:underline" %>
    </p>
  </div>
</div>
