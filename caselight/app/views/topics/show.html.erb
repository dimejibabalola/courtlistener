<% content_for :title, "#{@topic.name} — Topics" %>
<div class="mx-auto max-w-4xl px-6 py-8">
  <nav class="text-xs text-gray-500" aria-label="Breadcrumb">
    <%= link_to "Topics", topics_path, class: "hover:text-brand-700" %>
    <% @topic.ancestors.each do |ancestor| %>
      <span class="mx-1">›</span><%= link_to ancestor.name, topic_path(ancestor), class: "hover:text-brand-700" %>
    <% end %>
  </nav>

  <h1 class="mt-2 flex items-baseline gap-3 text-xl font-bold text-gray-900">
    <%= @topic.name %>
    <span class="text-sm font-normal text-gray-400"><%= @topic.code %></span>
  </h1>

  <% if @topic.children.any? %>
    <div class="mt-4 flex flex-wrap gap-2">
      <% @topic.children.each do |child| %>
        <%= link_to topic_path(child), class: "badge-gray !px-2.5 !py-1.5 !text-xs hover:bg-brand-50 hover:text-brand-800" do %>
          <%= child.name %> (<%= child.headnotes_count %>)
        <% end %>
      <% end %>
    </div>
  <% end %>

  <div class="mt-6 flex items-center justify-between">
    <h2 class="text-sm font-bold text-gray-900">Headnotes on this point (<%= @headnotes.size %>)</h2>
    <%= form_with url: topic_path(@topic), method: :get, data: { controller: "autosubmit" } do %>
      <%= select_tag :jurisdiction_id, options_for_select([["All jurisdictions", ""]] + @jurisdictions.map { |j| [j.name, j.id] }, params[:jurisdiction_id]),
            class: "field-input !w-auto !py-1 text-xs", data: { action: "change->autosubmit#submit" }, aria: { label: "Filter by jurisdiction" } %>
    <% end %>
  </div>

  <ul class="mt-3 space-y-4">
    <% @headnotes.each do |headnote| %>
      <li class="card p-4">
        <p class="text-[13px] leading-relaxed text-gray-700">
          <span class="font-bold text-brand-700">[<%= headnote.number %>]</span>
          <%= headnote.text %>
        </p>
        <div class="mt-2 flex flex-wrap items-center justify-between gap-2">
          <%= link_to headnote.document.title, document_path(headnote.document, anchor: headnote.anchor), class: "font-serif text-sm font-semibold text-gray-900 hover:text-brand-700" %>
          <p class="flex items-center gap-2 text-xs text-gray-500">
            <%= headnote.document.display_citation %> · <%= headnote.document.court_line %>
            <%= treatment_badge(headnote.document) %>
          </p>
        </div>
      </li>
    <% end %>
    <% if @headnotes.empty? %>
      <li class="py-8 text-center text-sm text-gray-500">No headnotes tagged under this node yet.</li>
    <% end %>
  </ul>
</div>
