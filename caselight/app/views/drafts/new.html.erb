<% content_for :title, "New Draft — Caselight" %>
<div class="mx-auto max-w-xl px-6 py-10">
  <h1 class="text-xl font-bold text-gray-900">New Draft</h1>
  <div class="card mt-5 p-5">
    <%= form_with model: @draft, class: "space-y-4" do |f| %>
      <div>
        <%= f.label :title, class: "field-label" %>
        <%= f.text_field :title, class: "field-input", required: true, placeholder: "e.g. Memo — veil piercing standard" %>
      </div>
      <div>
        <%= f.label :matter_id, "Matter (optional)", class: "field-label" %>
        <%= f.collection_select :matter_id, current_user.visible_matters.kept.order(:name), :id, :name, { include_blank: "— none —" }, class: "field-input" %>
      </div>
      <%= f.hidden_field :document_id %>
      <div class="flex gap-2">
        <%= f.submit "Create draft", class: "btn-primary" %>
        <%= link_to "Cancel", drafts_path, class: "btn-ghost" %>
      </div>
    <% end %>
  </div>
</div>
