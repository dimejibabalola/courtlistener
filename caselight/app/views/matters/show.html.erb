<% content_for :title, "#{@matter.name} — Matters" %>
<div class="mx-auto max-w-6xl px-6 py-8">
  <%= link_to matters_path, class: "flex items-center gap-1.5 text-sm font-medium text-brand-700 hover:underline" do %>
    <%= icon :arrow_left, class: "h-4 w-4" %> All matters
  <% end %>

  <header class="mt-3 flex flex-wrap items-start justify-between gap-3">
    <div>
      <h1 class="text-xl font-bold text-gray-900"><%= @matter.name %></h1>
      <p class="mt-0.5 text-sm text-gray-500">
        <%= @matter.matter_number %><%= " · " if @matter.matter_number.present? %><%= @matter.status.titleize %>
        <% if @matter.organization %> · shared with <%= @matter.organization.name %><% end %>
      </p>
      <% if @matter.description.present? %><p class="mt-2 max-w-2xl text-sm text-gray-600"><%= @matter.description %></p><% end %>
    </div>
    <div class="flex items-center gap-1.5">
      <%= link_to "Edit", edit_matter_path(@matter), class: "btn-ghost" %>
      <%= button_to "Archive", archive_matter_path(@matter), class: "btn-ghost" %>
      <%= button_to "Trash", trash_matter_path(@matter), class: "btn-ghost text-red-700", form: { data: { turbo_confirm: "Move this matter to trash?" } } %>
    </div>
  </header>

  <div class="mt-6 grid gap-5 lg:grid-cols-3">
    <section class="card p-4 lg:col-span-1" aria-label="Folders">
      <div class="flex items-center justify-between">
        <h2 class="text-sm font-bold text-gray-900">Research Folders</h2>
        <%= form_with url: folders_path, method: :post, class: "contents" do %>
          <%= hidden_field_tag "folder[matter_id]", @matter.id %>
          <%= hidden_field_tag "folder[name]", "New folder" %>
          <button type="submit" class="text-xs font-semibold text-brand-700 hover:underline">+ New</button>
        <% end %>
      </div>
      <ul class="mt-3 space-y-1">
        <% @folders.each do |folder| %>
          <li>
            <%= link_to folder_path(folder), class: "group flex items-center gap-2 rounded px-2 py-1.5 hover:bg-gray-50" do %>
              <%= icon :folder, class: "h-4 w-4 text-gray-400 group-hover:text-brand-600" %>
              <span class="min-w-0 flex-1 truncate text-[13px] text-gray-800"><%= folder.name %></span>
              <span class="text-xs tabular-nums text-gray-400"><%= folder.items_count %></span>
            <% end %>
          </li>
        <% end %>
        <% if @folders.empty? %><li class="text-xs text-gray-400">No folders yet.</li><% end %>
      </ul>
    </section>

    <section class="card p-4" aria-label="Uploads">
      <div class="flex items-center justify-between">
        <h2 class="text-sm font-bold text-gray-900">Uploaded Documents</h2>
        <%= link_to "+ Upload", new_upload_path(matter_id: @matter.id), class: "text-xs font-semibold text-brand-700 hover:underline" %>
      </div>
      <ul class="mt-3 space-y-2">
        <% @uploads.first(8).each do |upload| %>
          <li class="flex items-center justify-between gap-2">
            <%= link_to upload.title, upload_path(upload), class: "truncate text-[13px] font-medium text-gray-800 hover:text-brand-700" %>
            <span class="badge-gray shrink-0"><%= upload.status %></span>
          </li>
        <% end %>
        <% if @uploads.empty? %><li class="text-xs text-gray-400">No documents uploaded.</li><% end %>
      </ul>
    </section>

    <section class="card p-4" aria-label="Drafts">
      <div class="flex items-center justify-between">
        <h2 class="text-sm font-bold text-gray-900">Drafts</h2>
        <%= link_to "+ New draft", new_draft_path(matter_id: @matter.id), class: "text-xs font-semibold text-brand-700 hover:underline" %>
      </div>
      <ul class="mt-3 space-y-2">
        <% @drafts.first(8).each do |draft| %>
          <li>
            <%= link_to edit_draft_path(draft), class: "group block" do %>
              <p class="truncate text-[13px] font-medium text-gray-800 group-hover:text-brand-700"><%= draft.title %></p>
              <p class="text-[11px] text-gray-400">updated <%= time_ago_in_words(draft.updated_at) %> ago</p>
            <% end %>
          </li>
        <% end %>
        <% if @drafts.empty? %><li class="text-xs text-gray-400">No drafts yet.</li><% end %>
      </ul>
    </section>

    <section class="card p-4 lg:col-span-3" aria-label="Matter AI assistant">
      <h2 class="flex items-center gap-1.5 text-sm font-bold text-gray-900">
        Matter Research Assistant <%= icon :sparkle, class: "h-4 w-4 text-brand-600" %>
        <span class="rounded bg-amber-100 px-1 text-[10px] font-bold uppercase text-amber-700">Beta</span>
      </h2>
      <p class="mt-1 text-xs text-gray-500">Ask questions grounded in the authorities saved to this matter's folders.</p>
      <% if @conversation %>
        <p class="mt-2 text-xs"><%= link_to "Continue: #{@conversation.display_title}", ai_conversation_path(@conversation), class: "font-medium text-brand-700 hover:underline" %></p>
      <% end %>
      <%= form_with url: ai_conversations_path, method: :post, class: "mt-3 flex max-w-2xl gap-2" do %>
        <%= hidden_field_tag :context_type, "Matter" %>
        <%= hidden_field_tag :context_id, @matter.id %>
        <%= text_field_tag :question, nil, placeholder: "e.g. What is our strongest authority on undercapitalization?", required: true, class: "field-input flex-1" %>
        <button type="submit" class="btn-primary">Ask</button>
      <% end %>
    </section>
  </div>
</div>
