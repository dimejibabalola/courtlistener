<%= form_with model: matter, class: "space-y-4" do |f| %>
  <% if matter.errors.any? %>
    <div class="card border-red-200 bg-red-50 p-3 text-sm text-red-800"><%= matter.errors.full_messages.to_sentence %></div>
  <% end %>
  <div>
    <%= f.label :name, class: "field-label" %>
    <%= f.text_field :name, class: "field-input", required: true %>
  </div>
  <div>
    <%= f.label :matter_number, "Matter number", class: "field-label" %>
    <%= f.text_field :matter_number, class: "field-input", placeholder: "e.g. 2026-0042" %>
  </div>
  <div>
    <%= f.label :description, class: "field-label" %>
    <%= f.text_area :description, rows: 3, class: "field-input" %>
  </div>
  <div>
    <%= f.label :status, class: "field-label" %>
    <%= f.select :status, Matter.statuses.keys.map { |s| [s.titleize, s] }, {}, class: "field-input" %>
  </div>
  <% if current_user.organization %>
    <label class="flex items-center gap-2 text-sm text-gray-700">
      <%= check_box_tag "matter[shared]", "1", matter.organization_id.present?, class: "rounded border-gray-300 text-brand-600 focus:ring-brand-500" %>
      Share with <%= current_user.organization.name %> (firm workspace)
    </label>
  <% end %>
  <div class="flex gap-2">
    <%= f.submit matter.persisted? ? "Save changes" : "Create matter", class: "btn-primary" %>
    <%= link_to "Cancel", matters_path, class: "btn-ghost" %>
  </div>
<% end %>
