<% content_for :title, "Matters — Caselight" %>
<div class="mx-auto max-w-5xl px-6 py-8">
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-xl font-bold text-gray-900">Matters</h1>
      <p class="mt-1 text-sm text-gray-600">Client/matter workspaces with folders, uploads, drafts and AI research.</p>
    </div>
    <%= link_to new_matter_path, class: "btn-primary" do %>
      <%= icon :plus, class: "h-4 w-4" %> New Matter
    <% end %>
  </div>

  <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    <% @matters.each do |matter| %>
      <%= link_to matter_path(matter), class: "card group p-4 transition hover:border-brand-300 hover:shadow-sm" do %>
        <div class="flex items-start justify-between gap-2">
          <span class="flex h-9 w-9 items-center justify-center rounded-lg bg-brand-50 text-brand-700"><%= icon :briefcase, class: "h-5 w-5" %></span>
          <span class="badge-gray"><%= matter.status.titleize %></span>
        </div>
        <h2 class="mt-3 truncate text-sm font-bold text-gray-900 group-hover:text-brand-700"><%= matter.name %></h2>
        <% if matter.matter_number.present? %><p class="text-xs text-gray-500"><%= matter.matter_number %></p><% end %>
        <% if matter.description.present? %><p class="mt-1.5 line-clamp-2 text-xs text-gray-600"><%= matter.description %></p><% end %>
        <p class="mt-3 flex items-center gap-3 text-[11px] text-gray-400">
          <span><%= matter.folders.kept.count %> folders</span>
          <span><%= matter.uploaded_documents.kept.count %> uploads</span>
          <span>updated <%= time_ago_in_words(matter.updated_at) %> ago</span>
        </p>
      <% end %>
    <% end %>
  </div>
  <% if @matters.empty? %>
    <p class="mt-12 text-center text-sm text-gray-500">No matters yet — create one to organize research by client engagement.</p>
  <% end %>
</div>
