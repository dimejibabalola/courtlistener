# Copy to .env — loaded in development/test via dotenv-rails.

# --- AI providers (all optional; "local" provider needs nothing) -----------
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Embeddings (default: offline hash embedder) ---------------------------
# Real semantic search via the Qwen3-Embedding-0.6B service (embedding_service/):
#   cd embedding_service && pip install -r requirements.txt && uvicorn app:app --port 8000
# EMBEDDINGS_PROVIDER=qwen
# EMBEDDINGS_URL=http://localhost:8000
# Or hosted OpenAI embeddings:
# EMBEDDINGS_PROVIDER=openai
# EMBEDDINGS_OPENAI_MODEL=text-embedding-3-small

# --- Citation parsing -------------------------------------------------------
# CITATION_PARSER=eyecite   # eyecite|ruby; auto-detects eyecite by default
# PYTHON_BIN=python3

# --- Document extraction (MinerU; optional) ---------------------------------
MINERU_MODE=disabled        # api | local | disabled
MINERU_API_KEY=
MINERU_BASE_URL=https://mineru.net
MINERU_LOCAL_URL=http://localhost:8000

# --- CourtListener importer (optional) --------------------------------------
COURTLISTENER_API_KEY=
COURTLISTENER_BASE_URL=https://www.courtlistener.com

# --- Infrastructure ----------------------------------------------------------
# OPENSEARCH_URL=http://localhost:9200
# DISABLE_OPENSEARCH=1
# REDIS_URL=redis://localhost:6379/1
# USE_SIDEKIQ=1
