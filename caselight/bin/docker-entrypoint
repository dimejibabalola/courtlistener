#!/bin/bash -e

# If running the rails server then create or migrate existing database and load
# the demo corpus (db/seeds.rb is a no-op once data exists).
if [ "${@: -2:1}" == "./bin/rails" ] && [ "${@: -1:1}" == "server" ]; then
  ./bin/rails db:prepare
  ./bin/rails db:seed

  # Re-embed in the background when vectors are stale (e.g. after a dim change),
  # so it never blocks the web server from binding its port. Search falls back
  # to lexical until the vectors populate; a failure retries on the next boot.
  ( ./bin/rails embeddings:reindex_if_stale || echo "embeddings reindex failed; will retry next boot" ) &
fi

exec "${@}"
